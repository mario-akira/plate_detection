/*
 * Blue Pill (STM32F103C8) controlando o Grove Vision AI V2 pela UART.
 *
 * A cada INTERVALO_MS pede UMA inferência ao kit (AT+INVOKE=1,0,1), lê as caixas
 * e, quando há placa com score >= LIMIAR_SCORE:
 *   - acende o LED do kit (AT+LED=1) e o LED da Blue Pill (PC13);
 *   - depois de QUADROS_SEGUIDOS inferências seguidas, salva a foto no cartão SD
 *     do kit (AT+ACTION="save_jpeg()"), no máximo uma a cada ESPERA_FOTO_MS.
 * Se o kit não responder, conta como "nenhuma placa" e continua.
 *
 * Ligações (3,3 V nos dois lados, sem conversor de nível):
 *   Blue Pill PA9  (USART1 TX) -> RX do Grove Vision AI V2
 *   Blue Pill PA10 (USART1 RX) <- TX do Grove Vision AI V2
 *   GND <-> GND   (alimente o kit pela USB-C dele ou pelo pino de 5 V)
 *   Opcional, para ver o log no PC: PA2 (USART2 TX) -> RX de um adaptador USB-serial, 115200 baud
 *
 * Projeto: STM32CubeIDE, STM32F103C8Tx. No CubeMX configure só
 *   RCC: HSE = Crystal/Ceramic Resonator  e  SYS: Debug = Serial Wire.
 * NÃO habilite USART1/USART2 no CubeMX (este arquivo configura as UARTs e define a
 * interrupção USART1_IRQHandler). Substitua o main.c gerado por este e adicione
 * grove_at.c / grove_at.h ao projeto.
 */
#include "main.h"

#include <stdarg.h>
#include <stdio.h>
#include <string.h>

#include "grove_at.h"

/* ------------------------------ Ajustes ------------------------------ */
#define INTERVALO_MS      1000u   /* tempo entre inferências */
#define LIMIAR_SCORE      65      /* confiança mínima (0-100) para contar como placa */
#define QUADROS_SEGUIDOS  2       /* inferências seguidas acima do limiar para salvar */
#define ESPERA_FOTO_MS    5000u   /* tempo mínimo entre fotos */
#define LED_SEGURA_MS     2000u   /* LED fica aceso esse tempo depois da última detecção */
#define CLASSE_PLACA      0       /* id da classe "placa" no modelo */
#define SALVAR_NO_SD      1       /* 1 = salva foto no SD do kit; 0 = só LED */
#define TIMEOUT_MS        3000u   /* espera máxima por cada resposta do kit */
#define GROVE_BAUD        921600u /* velocidade padrão da UART do kit */
#define LOG_BAUD          115200u
/* -------------------------------------------------------------------- */

static void SystemClock_Config(void);

/* ============================ UARTs (registradores) ============================ */
static void uart_init(USART_TypeDef *u, uint32_t pclk, uint32_t baud, bool rx_irq)
{
    u->CR1 = 0;
    u->BRR = (pclk + baud / 2u) / baud;   /* 72 MHz / 921600 -> 78 (923 kbaud, erro 0,16%) */
    u->CR1 = USART_CR1_TE | USART_CR1_RE | (rx_irq ? USART_CR1_RXNEIE : 0u) | USART_CR1_UE;
}

static void uart_write(USART_TypeDef *u, const char *s)
{
    while (*s) {
        while (!(u->SR & USART_SR_TXE)) {}
        u->DR = (uint8_t)*s++;
    }
    while (!(u->SR & USART_SR_TC)) {}
}

void USART1_IRQHandler(void)
{
    uint32_t sr = USART1->SR;
    if (sr & (USART_SR_RXNE | USART_SR_ORE)) {
        uint8_t b = (uint8_t)USART1->DR;  /* ler SR e depois DR limpa RXNE e ORE */
        grove_rx_push(b);
    }
}

static void log_printf(const char *fmt, ...)
{
    char line[128];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(line, sizeof(line), fmt, ap);
    va_end(ap);
    uart_write(USART2, line);
}

static void hw_init(void)
{
    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOC_CLK_ENABLE();
    __HAL_RCC_USART1_CLK_ENABLE();
    __HAL_RCC_USART2_CLK_ENABLE();

    GPIO_InitTypeDef g = {0};
    g.Pin   = GPIO_PIN_9 | GPIO_PIN_2;          /* PA9 = TX1, PA2 = TX2 */
    g.Mode  = GPIO_MODE_AF_PP;
    g.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOA, &g);

    g.Pin  = GPIO_PIN_10 | GPIO_PIN_3;          /* PA10 = RX1, PA3 = RX2 */
    g.Mode = GPIO_MODE_INPUT;
    g.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(GPIOA, &g);

    g.Pin   = GPIO_PIN_13;                      /* LED da Blue Pill (aceso em nível baixo) */
    g.Mode  = GPIO_MODE_OUTPUT_PP;
    g.Pull  = GPIO_NOPULL;
    g.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOC, &g);
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, GPIO_PIN_SET);

    uart_init(USART1, HAL_RCC_GetPCLK2Freq(), GROVE_BAUD, true);
    uart_init(USART2, HAL_RCC_GetPCLK1Freq(), LOG_BAUD, false);
    HAL_NVIC_SetPriority(USART1_IRQn, 0, 0);
    HAL_NVIC_EnableIRQ(USART1_IRQn);
}

/* ============================ comandos para o kit ============================ */
static void grove_send(const char *cmd)
{
    grove_rx_flush();                           /* respostas atrasadas não contam */
    uart_write(USART1, cmd);
}

/* espera uma mensagem com esse type e name; devolve true se chegou com code 0 */
static bool grove_wait(long type, const char *name, uint32_t timeout_ms)
{
    uint32_t t0 = HAL_GetTick();
    while (HAL_GetTick() - t0 < timeout_ms) {
        if (!grove_poll_message()) continue;
        const char *m = grove_last_message();
        long t, code = 0;
        if (grove_json_int(m, "type", &t) && t == type && grove_json_str_contains(m, "name", name)) {
            grove_json_int(m, "code", &code);
            return code == 0;
        }
    }
    return false;
}

/* uma inferência; devolve o maior score da placa (0 se nada ou se o kit não respondeu) */
static int grove_invoke(bool *ok)
{
    grove_send("AT+INVOKE=1,0,1\r\n");          /* 1 vez, sem filtro, só resultados (sem imagem) */
    *ok = grove_wait(0, "INVOKE", TIMEOUT_MS) && grove_wait(1, "INVOKE", TIMEOUT_MS);
    return *ok ? grove_best_score(grove_last_message(), CLASSE_PLACA) : 0;
}

static void grove_led(bool on)
{
    uart_write(USART1, on ? "AT+LED=1\r\n" : "AT+LED=0\r\n");   /* sem resposta */
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, on ? GPIO_PIN_RESET : GPIO_PIN_SET);
}

static bool grove_save_jpeg(void)
{
    grove_send("AT+ACTION=\"save_jpeg()\"\r\n"); /* salva o quadro da próxima inferência */
    if (!grove_wait(0, "ACTION", TIMEOUT_MS)) return false;
    bool ok;
    (void)grove_invoke(&ok);
    grove_send("AT+ACTION=\"\"\r\n");            /* remove a ação */
    grove_wait(0, "ACTION", TIMEOUT_MS);
    return ok;
}

/* ================================== main ================================== */
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    hw_init();
    HAL_Delay(1500);                            /* tempo para o kit ligar */

    uart_write(USART1, "AT+BREAK\r\n");          /* para inferência contínua deixada pelo SenseCraft */
    HAL_Delay(300);
    grove_led(false);
    log_printf("Deteccao de placas: 1 inferencia a cada %lu ms\r\n", (unsigned long)INTERVALO_MS);

    uint32_t next = HAL_GetTick();
    uint32_t last_seen = 0, last_photo = 0;
    bool seen_once = false, photo_once = false, led_on = false;
    int seq = 0;

    for (;;) {
        while ((int32_t)(HAL_GetTick() - next) < 0) {}   /* espera o próximo ciclo */
        next += INTERVALO_MS;

        bool ok;
        int score = grove_invoke(&ok);
        uint32_t now = HAL_GetTick();

        if (score >= LIMIAR_SCORE) {
            seq++;
            last_seen = now;
            seen_once = true;
        } else {
            seq = 0;
        }

        bool want_led = seen_once && (now - last_seen <= LED_SEGURA_MS);
        if (want_led != led_on) {
            grove_led(want_led);
            led_on = want_led;
        }

        log_printf("%s placa=%d seguidas=%d%s\r\n", ok ? "ok " : "SEM RESPOSTA", score, seq,
                   led_on ? " LED" : "");

#if SALVAR_NO_SD
        if (seq >= QUADROS_SEGUIDOS && (!photo_once || now - last_photo >= ESPERA_FOTO_MS)) {
            bool saved = grove_save_jpeg();
            log_printf(saved ? ">> foto salva no SD\r\n" : ">> nao salvou (SD? firmware?)\r\n");
            if (saved) {
                last_photo = now;
                photo_once = true;
            }
            seq = 0;
        }
#endif
        if ((int32_t)(HAL_GetTick() - next) > (int32_t)INTERVALO_MS) {
            next = HAL_GetTick();               /* atrasou muito: não tenta compensar */
        }
    }
}

/* 72 MHz a partir do cristal de 8 MHz da Blue Pill */
static void SystemClock_Config(void)
{
    RCC_OscInitTypeDef osc = {0};
    osc.OscillatorType = RCC_OSCILLATORTYPE_HSE;
    osc.HSEState       = RCC_HSE_ON;
    osc.HSEPredivValue = RCC_HSE_PREDIV_DIV1;
    osc.HSIState       = RCC_HSI_ON;
    osc.PLL.PLLState   = RCC_PLL_ON;
    osc.PLL.PLLSource  = RCC_PLLSOURCE_HSE;
    osc.PLL.PLLMUL     = RCC_PLL_MUL9;
    if (HAL_RCC_OscConfig(&osc) != HAL_OK) Error_Handler();

    RCC_ClkInitTypeDef clk = {0};
    clk.ClockType      = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK | RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
    clk.SYSCLKSource   = RCC_SYSCLKSOURCE_PLLCLK;
    clk.AHBCLKDivider  = RCC_SYSCLK_DIV1;
    clk.APB1CLKDivider = RCC_HCLK_DIV2;          /* 36 MHz (USART2) */
    clk.APB2CLKDivider = RCC_HCLK_DIV1;          /* 72 MHz (USART1) */
    if (HAL_RCC_ClockConfig(&clk, FLASH_LATENCY_2) != HAL_OK) Error_Handler();
}

void Error_Handler(void)
{
    __disable_irq();
    for (;;) {}
}
